    "type": "momentum",
    "description": "D\u00e9tection de momentum et cassures de r\u00e9sistances avec confirmation volume",
    "indicators": [
      {
        "name": "RSI",
        "parameters": {
          "period": 14,
          "overbought": 70,
          "oversold": 30
