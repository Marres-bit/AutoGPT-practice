          "std_dev": 2
        },
        "weight": 0.3,
        "success_rate": 0.0
      },
      {
        "name": "Funding_Rate",
        "parameters": {
          "threshold": 0.0001,
          "market": "futures"
        },
        "weight": 0.4,
        "success_rate": 0.0
      }
    ],
    "rules": [
      {
        "rule_id": "BN_H1",
        "description": "Long si prix touche BB inf\u00e9rieur + EMA haussi\u00e8re",
