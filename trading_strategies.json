        "action": "OPEN_LONG",
        "priority": 1,
        "success_count": 0,
        "fail_count": 0,
        "enabled": true
      },
      {
        "rule_id": "BX_M2",
        "description": "Stop loss agressif mais contr\u00f4l\u00e9",
        "condition": "price < entry * 0.97",
        "action": "CLOSE_POSITION",
        "priority": 2,
        "success_count": 0,
        "fail_count": 0,
        "enabled": true
      },
      {
        "rule_id": "BX_M3",
        "description": "Take profit sur momentum faibli",
        "condition": "price > entry * 1.05 AND rsi > 70",
        "action": "CLOSE_POSITION",
        "priority": 3,
        "success_count": 0,
        "fail_count": 0,
        "enabled": true
      }
    ],
    "risk_parameters": {
      "max_position_size": 0.15,
