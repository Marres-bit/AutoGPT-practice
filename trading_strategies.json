        "weight": 0.3,
        "success_rate": 0.0
      },
      {
        "name": "Volume_Confirmation",
        "parameters": {
          "threshold_multiplier": 1.5,
          "lookback": 20
        },
        "weight": 0.4,
        "success_rate": 0.0
      },
      {
        "name": "Price_Breakout",
        "parameters": {
          "resistance_period": 24,
          "confirmation_candles": 2
        },
        "weight": 0.3,
        "success_rate": 0.0
