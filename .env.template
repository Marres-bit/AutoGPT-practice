# Configuration Binance Production
# ⚠️ NE JAMAIS PARTAGER CE FICHIER
# À renommer en .env et compléter avec vos vraies clés

# ============================================
# BINANCE API CREDENTIALS (PRODUCTION)
# ============================================
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# ============================================
# MODE DE TRADING
# ============================================
BINANCE_TESTNET=False  # False = Production, True = TestNet
TRADING_ENABLED=True
AUTO_START=False  # Laisser False pour démarrage manuel sécurisé

# ============================================
# PARAMÈTRES DE SÉCURITÉ (CRITIQUE)
# ============================================

# Capital et Limites
INITIAL_CAPITAL=10000  # Capital initial en EUR
MAX_POSITION_SIZE=500  # Maximum par trade en EUR (5% de 10000€)
MAX_POSITION_PERCENT=0.05  # 5% du capital max par position

# Stop-Loss et Take-Profit
STOP_LOSS_PCT=0.02  # Stop-loss à 2% (-20€ sur 1000€)
TAKE_PROFIT_PCT=0.05  # Take-profit à 5% (+50€ sur 1000€)

# Limites Quotidiennes
MAX_DAILY_TRADES=20  # Maximum de trades par jour
DAILY_LOSS_LIMIT=100  # Arrêt auto si perte > 100€/jour
DAILY_PROFIT_TARGET=200  # Optionnel : pause si objectif atteint

# Limites Globales
MAX_CONSECUTIVE_LOSSES=5  # Pause après X pertes consécutives
EMERGENCY_STOP_LOSS=-500  # Arrêt d'urgence si perte totale > 500€
MAX_OPEN_POSITIONS=3  # Nombre max de positions ouvertes simultanément

# ============================================
# CONFIGURATION TRADING
# ============================================

# Fréquence d'Analyse
ANALYSIS_INTERVAL_HOURS=4  # Analyse toutes les 4 heures (6 fois/jour)

# Assets Autorisés (Commencer conservateur)
ALLOWED_ASSETS=BTC,ETH  # Ajouter SOL seulement si patterns OK

# Paires de Trading
QUOTE_CURRENCY=USDT  # USDT ou EUR (selon disponibilité Binance)

# ============================================
# SYSTÈME D'APPRENTISSAGE
# ============================================

# Apprentissage Permanent
LEARNING_ENABLED=True
LEARNING_RATE=0.1  # Vitesse d'ajustement (0-1)

# Seuils Adaptatifs
MIN_GAIN_TO_OPEN=0.5  # Gain minimum requis pour ouvrir (%)
ADAPTIVE_THRESHOLD=True  # Ajustement automatique selon performance

# Niveau de Risque
RISK_LEVEL=0.5  # 0.2 (conservateur) à 0.8 (agressif)
AUTO_ADJUST_RISK=True  # Ajustement auto selon win rate

# ============================================
# NOTIFICATIONS
# ============================================

# Email (Recommandé)
EMAIL_NOTIFICATIONS=True
EMAIL_RECIPIENT=votre@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASSWORD=votre_mot_de_passe_app

# Telegram (Optionnel mais pratique)
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notifications à recevoir
NOTIFY_ON_TRADE=True  # Chaque trade
NOTIFY_ON_ERROR=True  # Erreurs
NOTIFY_ON_DAILY_SUMMARY=True  # Résumé quotidien
NOTIFY_ON_STOP_LOSS=True  # Stop-loss déclenché
NOTIFY_ON_EMERGENCY=True  # Arrêt d'urgence

# ============================================
# FRAIS BINANCE
# ============================================
BINANCE_MAKER_FEE=0.001  # 0.1% (avec BNB peut être 0.075%)
BINANCE_TAKER_FEE=0.001  # 0.1%
USE_BNB_FOR_FEES=True  # Utiliser BNB pour réduire frais (recommandé)

# ============================================
# SÉCURITÉ AVANCÉE
# ============================================

# IP Whitelist (Recommandé)
IP_WHITELIST_ENABLED=False  # À activer après avoir ajouté votre IP sur Binance
ALLOWED_IPS=  # Votre IP publique

# Validation Manuelle (Phase de démarrage)
REQUIRE_MANUAL_APPROVAL=False  # True = approbation manuelle chaque trade
APPROVAL_TIMEOUT=300  # Timeout en secondes (5 min)

# Sauvegarde et Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
SAVE_TRADE_HISTORY=True
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24

# ============================================
# MODE DEBUG (À désactiver en production)
# ============================================
DEBUG_MODE=False  # True = logs verbeux, False = production
SIMULATE_TRADES=False  # True = simulation, False = trades réels
DRY_RUN=False  # True = tout simuler sans exécuter

# ============================================
# STRATÉGIES AVANCÉES
# ============================================

# Gestion des Assets Problématiques
AUTO_BLACKLIST_ASSETS=True  # Blacklist auto si perte > 60%
BLACKLIST_THRESHOLD=0.6  # Seuil de perte pour blacklist
MIN_TRADES_FOR_BLACKLIST=5  # Minimum de trades avant blacklist

# Conditions de Marché
AVOID_NEGATIVE_MARKET=True  # Pas de trade si marché global négatif
NEGATIVE_MARKET_THRESHOLD=-2.0  # Seuil en %
HIGH_VOLATILITY_PAUSE=True  # Pause si volatilité excessive
VOLATILITY_THRESHOLD=5.0  # Écart max/min en %

# Réinvestissement
AUTO_REINVEST=False  # Réinvestir automatiquement les bénéfices
REINVEST_PERCENT=0.5  # 50% des bénéfices réinvestis
WITHDRAW_TO_PRINCIPAL=True  # 20% des gains vers capital principal

# ============================================
# ALERTES ET SEUILS
# ============================================

# Win Rate
MIN_WIN_RATE_ALERT=0.45  # Alerte si win rate < 45%
TARGET_WIN_RATE=0.60  # Objectif de win rate

# Performance
MIN_DAILY_PROFIT=-50  # Alerte si perte quotidienne > 50€
TARGET_WEEKLY_PROFIT=500  # Objectif hebdomadaire en €

# Santé du Système
HEALTH_CHECK_INTERVAL=3600  # Vérification toutes les heures (secondes)
AUTO_RESTART_ON_ERROR=False  # Redémarrage auto (risqué, à éviter)

# ============================================
# INFORMATIONS IMPORTANTES
# ============================================

# ⚠️ SÉCURITÉ
# 1. Ne JAMAIS activer "Enable Withdrawals" sur Binance API
# 2. Activer 2FA sur compte Binance
# 3. Utiliser IP Whitelist si possible
# 4. Sauvegarder ce fichier en lieu sûr
# 5. Ne JAMAIS partager vos clés API

# 📊 DÉMARRAGE PROGRESSIF
# Phase 1 (Jour 1): INITIAL_CAPITAL=500, MAX_POSITION_SIZE=50
# Phase 2 (Semaine 1): INITIAL_CAPITAL=1000, MAX_POSITION_SIZE=100
# Phase 3 (Semaine 2+): INITIAL_CAPITAL=5000+, MAX_POSITION_SIZE=250-500

# 🎯 OBJECTIFS RÉALISTES
# Capital 5000€ → 100-200€/semaine
# Capital 10000€ → 300-500€/semaine
# Capital 15000€ → 500-750€/semaine

# ⚠️ RAPPEL
# Le trading comporte des risques. Ne tradez que l'argent que vous 
# pouvez vous permettre de perdre. Les performances passées ne 
# garantissent pas les résultats futurs.
